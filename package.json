{
  "private": true,
  "name": "changelog",
  "description": "",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Piotr Kowalski",
    "email": "piecioshka@gmail.com",
    "url": "https://piecioshka.pl/"
  },
  "scripts": {
    "clear": "rm -rf dist/ coverage/ .nyc_output/",
    "clear:all": "rm -rf node_modules/ && npm run clear",
    "e2e": "jest --rootDir e2e/specs/",
    "test": "jest --rootDir test/specs/",
    "test:watch": "npm run test -- --watch",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "coverage": "npm run test -- --coverage",
    "count": "find . -name '*.js' -not -path './node_modules/*' | xargs wc -l | sort -r",
    "lint": "eslint .",
    "version": "npm run build && git add dist/",
    "postversion": "git push --tags",
    "predeploy": "npm version patch && git push && git push --tags",
    "deploy": "",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "eslint-config-piecioshka": "^2.3.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-smells": "^1.0.1",
    "eslint-plugin-todo-with-label": "^2.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.1",
    "puppeteer": "^21.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/piecioshka/changelog.git"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "package.json",
    "LICENSE",
    "README.md",
    "!**/*.spec.*"
  ],
  "keywords": [],
  "main": "./index.js",
  "bin": {
    "changelog": "bin/cli.js"
  }
}
